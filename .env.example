# Copie este arquivo para .env e preencha com seus valores
PORT=3000
NODE_ENV=development

POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=efacil_db
POSTGRES_DB_TEST=efacil_db_test

DATABASE_URL=postgresql://usuario:senha@localhost:5435/efacil_db
TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5435/efacil_db_test

JWT_SECRET=minimo_32_caracteres_aqui
JWT_EXPIRES_IN=15m
REFRESH_SECRET=outro_segredo_minimo_32_caracteres
REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:8080

EVOLUTION_API_URL=https://sua-url-evolution.com
EVOLUTION_API_KEY=sua_chave_api
EVOLUTION_INSTANCE=sua_instancia

OPENAI_API_KEY=sk-proj-sua_chave_openai

ADMIN_SECRET=minimo_16_caracteres_admin_aqui
WEBHOOK_SECRET=minimo_16_caracteres_webhook_aqui

# Segredo compartilhado com o proxy messages-api-proxy (deve ser igual ao INTERNAL_API_SECRET do proxy)
INTERNAL_API_SECRET=minimo_16_caracteres_internal_aqui

# ── API Oficial do WhatsApp (Cloud API / Meta) ───────────────────────────────
# Necessário apenas para conexões type=whatsapp-oficial. O webhook público é
# GET/POST /wabcloudapi/webhook (cadastre a URL no painel do app da Meta).
META_GRAPH_API_VERSION=v21.0
WAB_APP_ID=id_do_app_da_meta
WAB_APP_SECRET=secret_do_app_da_meta
WAB_USER_TOKEN=token_do_system_user
WAB_WEBHOOK_VERIFY_TOKEN=kelmor

# ── RabbitMQ (barramento de eventos com o bays) ───────────────────────────────
# USE_RABBITMQ=false → recebe só por HTTP webhook (fallback garantido).
# Ative (true) somente com o broker no ar E o consumidor validado em staging.
USE_RABBITMQ=
RABBITMQ_URL=
RABBITMQ_PORT1=
RABBITMQ_USER=
RABBITMQ_PASS=
